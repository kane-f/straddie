# Raw source documents dropped for ingestion.
# These are working files (may contain personal info) and are never committed;
# only the resulting Markdown pages under docs/ are checked in.
/ingest/

# MkDocs build output
/site/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS cruft
.DS_Store

# Editors
.vscode/
.idea/

# Secrets — never commit these
.env
.env.*
*.pem
*.key
secrets.*

# Plaque generator: real Wi-Fi credentials, and the image generated from
# them (the QR code encodes the password directly) — room plaques in
# plaques/output/ don't contain secrets and are tracked normally.
/plaques/wifi.local.yml
/plaques/output/wifi.png

# Palette review sheet from plaques/swatches.py — a working file, not a
# deliverable.
/plaques/output/swatches.png
